# ============================================================
# YouTube Content HQ - Environment Configuration Template
# ============================================================

# 1. Private Owner Passcode (used to unlock the app on laptop, iPhone 13, and Android)
# Default is admin123. Change to your own private passphrase in production.
AUTH_PASSCODE=admin123

# Optional Session Secret Salt
SESSION_SECRET=youtube_hq_production_session_secret_2026

# Cloudflare D1 Database Name
D1_DATABASE_NAME=youtube-hq-db

# ============================================================
# Optional: Cloudflare D1 Remote REST API Configuration
# (Required ONLY if you deploy on Render, Vercel, Railway, or external VPS)
# Leave blank when deploying directly on Cloudflare Pages (uses native env.DB)
# ============================================================
CF_ACCOUNT_ID=
CF_DATABASE_ID=
CF_API_TOKEN=
