{
  "name": "youtube-content-hq",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "node server.js",
    "build": "tsc && vite build",
    "deploy": "wrangler pages deploy dist",
    "typecheck": "tsc -p tsconfig.json && tsc -p functions/tsconfig.json",
    "preview": "vite preview",
    "pages:dev": "wrangler pages dev --compatibility-date=2024-04-01 --d1=DB=youtube-hq-db -- npm run dev",
    "d1:init": "wrangler d1 execute youtube-hq-db --local --file=./migrations/0001_initial.sql",
    "d1:migrate:prod": "wrangler d1 execute youtube-hq-db --remote --file=./migrations/0001_initial.sql"
  },
  "dependencies": {
    "@cloudflare/workers-types": "^4.20240405.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "lucide-react": "^0.378.0",
    "postcss": "^8.4.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.3.0",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.5",
    "vite": "^5.2.11",
    "wrangler": "^3.57.1"
  }
}
